---
interface Props {
  title: string;
  summary: string;
  status: string;
  phase: string;
  members: string[];
  heroImage: string;
  tags: string[];
  repo?: string;
  gallery: string[];
}

const { title, summary, status, phase, members, heroImage, tags, repo, gallery } =
  Astro.props;

const statusColors: Record<string, string> = {
  planned: '#6c757d',
  'in-progress': '#0d6efd',
  completed: '#198754',
  'on-hold': '#ffc107',
};

const statusColor = statusColors[status] ?? '#6c757d';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Aces Guild</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        background: #f5f5f5;
        color: #333;
      }
      nav {
        background: #2c3e50;
        padding: 12px 40px;
      }
      nav a {
        color: #fff;
        text-decoration: none;
        margin-right: 20px;
      }
      nav a:hover {
        text-decoration: underline;
      }
      .container {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 40px;
      }
      h1 {
        color: #2c3e50;
        margin-top: 0;
      }
      .summary {
        font-size: 1.1rem;
        color: #555;
        margin-bottom: 20px;
      }
      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 20px;
      }
      .badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 0.85rem;
        color: #fff;
      }
      .members {
        margin-bottom: 20px;
      }
      .members h3 {
        margin-bottom: 6px;
      }
      .members ul,
      .tags ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .members li {
        background: #e9ecef;
        color: #333;
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 0.9rem;
      }
      .tags {
        margin-bottom: 24px;
      }
      .tags li {
        background: #d1ecf1;
        color: #0c5460;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 0.85rem;
      }
      .repo-link {
        display: inline-block;
        margin-bottom: 24px;
        padding: 8px 16px;
        background: #2c3e50;
        color: #fff;
        text-decoration: none;
        border-radius: 4px;
      }
      .repo-link:hover {
        background: #34495e;
      }
      .hero-image {
        width: 100%;
        height: 320px;
        border-radius: 8px;
        margin-bottom: 32px;
        background-color: #d0d0d0;
        background-size: cover;
        background-position: center;
      }
      .content {
        line-height: 1.7;
      }
      .content h2 {
        color: #2c3e50;
        margin-top: 2rem;
      }
      .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 16px;
        margin-top: 40px;
      }
      .gallery-item {
        width: 100%;
        height: 200px;
        border-radius: 6px;
        background-color: #d0d0d0;
        background-size: cover;
        background-position: center;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/projects/">Projects</a>
    </nav>
    <div class="container">
      <h1>{title}</h1>
      <p class="summary">{summary}</p>

      <div class="meta">
        <span class="badge" style={`background: ${statusColor}`}>{status}</span>
        <span class="badge" style="background: #6c757d">{phase}</span>
      </div>

      {
        repo && (
          <a class="repo-link" href={repo} target="_blank" rel="noopener noreferrer">
            View Repo
          </a>
        )
      }

      <div class="members">
        <h3>Members</h3>
        <ul>
          {members.map((m) => <li>{m}</li>)}
        </ul>
      </div>

      <div class="tags">
        <ul>
          {tags.map((t) => <li>{t}</li>)}
        </ul>
      </div>

      <div
        class="hero-image"
        style={`background-image: url('${heroImage}')`}
        role="img"
        aria-label={`${title} hero image`}
      >
      </div>

      <div class="content">
        <slot />
      </div>

      {
        gallery.length > 0 && (
          <div class="gallery">
            {gallery.map((img, i) => (
              <div
                class="gallery-item"
                style={`background-image: url('${img}')`}
                role="img"
                aria-label={`${title} gallery image ${i + 1}`}
              />
            ))}
          </div>
        )
      }
    </div>
  </body>
</html>
