---
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => !data.draft);
projects.sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const statusColors: Record<string, string> = {
  planned: '#6c757d',
  'in-progress': '#0d6efd',
  completed: '#198754',
  'on-hold': '#ffc107',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Projects — Aces Guild</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        background: #f5f5f5;
        color: #333;
      }
      nav {
        background: #2c3e50;
        padding: 12px 40px;
      }
      nav a {
        color: #fff;
        text-decoration: none;
        margin-right: 20px;
      }
      nav a:hover {
        text-decoration: underline;
      }
      .container {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 40px;
      }
      h1 {
        color: #2c3e50;
      }
      .project-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .project-card {
        background: #fff;
        border-radius: 8px;
        padding: 24px;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
      }
      .project-card h2 {
        margin-top: 0;
        color: #2c3e50;
      }
      .project-card h2 a {
        color: #2c3e50;
        text-decoration: none;
      }
      .project-card h2 a:hover {
        text-decoration: underline;
      }
      .project-card p {
        color: #555;
        margin-bottom: 16px;
      }
      .meta {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 12px;
      }
      .badge {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 4px;
        font-size: 0.8rem;
        color: #fff;
      }
      .read-more {
        display: inline-block;
        padding: 6px 14px;
        background: #2c3e50;
        color: #fff;
        border-radius: 4px;
        text-decoration: none;
        font-size: 0.9rem;
      }
      .read-more:hover {
        background: #34495e;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
    </nav>
    <div class="container">
      <h1>Projects</h1>
      <div class="project-list">
        {
          projects.map((project) => (
            <div class="project-card">
              <h2>
                <a href={`/projects/${project.slug}/`}>{project.data.title}</a>
              </h2>
              <div class="meta">
                <span
                  class="badge"
                  style={`background: ${statusColors[project.data.status] ?? '#6c757d'}`}
                >
                  {project.data.status}
                </span>
                <span class="badge" style="background: #6c757d">
                  {project.data.phase}
                </span>
              </div>
              <p>{project.data.summary}</p>
              <a class="read-more" href={`/projects/${project.slug}/`}>
                Read more
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </body>
</html>
