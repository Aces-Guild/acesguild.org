---
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const featuredProjects = allProjects.filter((p) => p.data.featured);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aces Guild</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        background: #f5f5f5;
        color: #333;
      }
      header {
        background: #2c3e50;
        color: #fff;
        padding: 60px 40px;
      }
      header h1 {
        font-size: 2.5rem;
        margin: 0 0 12px;
      }
      header p {
        font-size: 1.1rem;
        margin: 0;
        opacity: 0.85;
        max-width: 600px;
      }
      .container {
        max-width: 900px;
        margin: 40px auto;
        padding: 0 40px;
      }
      h2 {
        color: #2c3e50;
      }
      .intro {
        font-size: 1rem;
        color: #555;
        max-width: 600px;
        line-height: 1.6;
      }
      .all-projects {
        display: inline-block;
        margin: 24px 0;
        padding: 10px 20px;
        background: #2c3e50;
        color: #fff;
        text-decoration: none;
        border-radius: 4px;
      }
      .all-projects:hover {
        background: #34495e;
      }
      .project-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
      }
      .project-card {
        background: #fff;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
      }
      .project-card h3 {
        margin-top: 0;
        color: #2c3e50;
      }
      .project-card a {
        color: #2c3e50;
        text-decoration: none;
      }
      .project-card a:hover {
        text-decoration: underline;
      }
      .project-card p {
        color: #555;
        font-size: 0.95rem;
        margin-bottom: 0;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Aces Guild</h1>
      <p>
        A group with the common pursuit of exploration and Adventures in Computer Electronics and
        Science
      </p>
    </header>
    <div class="container">
      <p class="intro">
        We're a family of makers, tinkerers, and learners. Aces Guild is where we document the
        things we build together — from rockets to electronics to whatever comes next.
      </p>
      <a class="all-projects" href="/projects/">Browse All Projects</a>

      {
        featuredProjects.length > 0 && (
          <>
            <h2>Featured Projects</h2>
            <div class="project-cards">
              {featuredProjects.map((project) => (
                <div class="project-card">
                  <h3>
                    <a href={`/projects/${project.slug}/`}>{project.data.title}</a>
                  </h3>
                  <p>{project.data.summary}</p>
                </div>
              ))}
            </div>
          </>
        )
      }
    </div>
  </body>
</html>
